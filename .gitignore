# Python environments and caches
.venv/
__pycache__/
*.pyc

# Secrets and tokens (never commit)
.env
.env.*
*.token
.huggingface/
.cache/

# Model weights and large artifacts
*.pt
*.pth
*.safetensors
*.ckpt

# Local pipeline outputs (may contain unreleased designs)
placement-corpus/outputs/
.DS_Store

