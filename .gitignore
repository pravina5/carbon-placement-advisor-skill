placement-reviews/

# Editor, test and build leftovers
.idea/
.vscode/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
*.log

# Packaged skill output from package_skill.py
*.skill

# Keys, certificates and local Bob settings that may hold secrets
*.pem
*.key
.bob/settings/
.bob/mcp.json

# Test machine output folders
reviews/
